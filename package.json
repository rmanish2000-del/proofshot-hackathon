{
  "name": "proofshot-hackathon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ProofShot, rewritten during the hackathon: a deterministic release gate and a hash-chained receipt for AI product photos.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "page": "node --experimental-strip-types scripts/page.ts",
    "call:baseten": "node --experimental-strip-types scripts/baseten-call.ts",
    "call:sam": "node --experimental-strip-types scripts/sam-call.ts",
    "intake": "node --experimental-strip-types scripts/intake.ts",
    "shop": "node --experimental-strip-types scripts/shop-build.ts",
    "serve": "node --experimental-strip-types scripts/serve.ts",
    "job:live": "node --experimental-strip-types scripts/live-job.ts",
    "demo:replay": "node --experimental-strip-types scripts/replay.ts",
    "demo:record": "node --experimental-strip-types scripts/record.ts",
    "calibrate": "node --experimental-strip-types scripts/calibrate.ts",
    "demo:canned": "node --experimental-strip-types scripts/demo-recordings.ts"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@meta-sam/parser": "0.1.0",
    "jpeg-js": "0.4.4"
  }
}
